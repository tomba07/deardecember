{
  "name": "dear-december",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node --watch --env-file-if-exists=.env server/dev.mjs",
    "preview": "python3 -m http.server 8123 --directory dist",
    "validate:format": "node scripts/validate-format.mjs",
    "generate:validator": "node scripts/generate-validator.mjs",
    "test": "npm run generate:validator && node scripts/generate-markdown.mjs && node --test tests/*.test.mjs",
    "start": "node server/index.mjs",
    "dev:accounts": "node --watch --env-file=.env.accounts server/index.mjs"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "jspdf": "^4.2.1",
    "marked": "^18.1.1",
    "playwright": "^1.62.1"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "sharp": "0.35.5"
  },
  "overrides": {
    "esbuild": "$esbuild"
  }
}
